rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Profiles: users can only read/write their own profile
    match /profiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.full_name is string
        && request.resource.data.full_name.size() <= 100
        && request.resource.data.email is string;
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.full_name is string
        && request.resource.data.full_name.size() <= 100
        && request.resource.data.email is string;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Settings: users can only read/write their own settings
    match /settings/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && (!('remindersEnabled' in request.resource.data) || request.resource.data.remindersEnabled is bool)
        && (!('defaultReminderMinutes' in request.resource.data) || request.resource.data.defaultReminderMinutes is int);
    }

    // Shifts: users can only CRUD their own shifts
    match /shifts/{shiftId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId is string
        && request.resource.data.company is string
        && request.resource.data.company.size() <= 200
        && request.resource.data.startTime is int
        && request.resource.data.endTime is int
        && request.resource.data.endTime > request.resource.data.startTime
        && request.resource.data.hourlyRate is number
        && request.resource.data.hourlyRate >= 0
        && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 1000))
        && (request.resource.data.userId == request.auth.uid || 'teamShiftId' in request.resource.data);
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.company is string
        && request.resource.data.company.size() <= 200
        && request.resource.data.startTime is int
        && request.resource.data.endTime is int
        && request.resource.data.endTime > request.resource.data.startTime
        && request.resource.data.hourlyRate is number
        && request.resource.data.hourlyRate >= 0
        && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 1000));
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Jobs: users can read own jobs; team managers can read member jobs
    match /jobs/{jobId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.defaultHourlyRate is number
        && request.resource.data.defaultHourlyRate >= 0
        && request.resource.data.goalHours is number
        && request.resource.data.goalHours >= 0;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.defaultHourlyRate is number
        && request.resource.data.defaultHourlyRate >= 0
        && request.resource.data.goalHours is number
        && request.resource.data.goalHours >= 0;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Pay Adjustments: users can only CRUD their own adjustments
    match /pay_adjustments/{adjustmentId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.cycleKey is string
        && request.resource.data.employer is string
        && request.resource.data.type is string
        && request.resource.data.amount is number;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.cycleKey is string
        && request.resource.data.employer is string
        && request.resource.data.type is string
        && request.resource.data.amount is number;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Teams: owner can manage, members can read
    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.inviteCode is string;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100;
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // Team Members: managers can manage, members can read their own
    match /team_members/{membershipId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId is string
        && request.resource.data.teamId is string
        && request.resource.data.role is string
        && (request.resource.data.role == "manager" || request.resource.data.role == "member");
      allow update: if request.auth != null
        && request.resource.data.role is string
        && (request.resource.data.role == "manager" || request.resource.data.role == "member");
      allow delete: if request.auth != null;
    }

    // Team Shifts: managers can assign, members can read/accept/decline their own
    match /team_shifts/{shiftId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.teamId is string
        && request.resource.data.assignedTo is string
        && request.resource.data.assignedBy == request.auth.uid
        && request.resource.data.company is string
        && request.resource.data.startTime is int
        && request.resource.data.endTime is int
        && request.resource.data.endTime > request.resource.data.startTime
        && request.resource.data.status is string
        && (request.resource.data.status == "assigned" || request.resource.data.status == "accepted" || request.resource.data.status == "declined");
      allow update: if request.auth != null
        && (resource.data.assignedBy == request.auth.uid || resource.data.assignedTo == request.auth.uid)
        && request.resource.data.status is string
        && (request.resource.data.status == "assigned" || request.resource.data.status == "accepted" || request.resource.data.status == "declined");
      allow delete: if request.auth != null
        && resource.data.assignedBy == request.auth.uid;
    }
  }
}
