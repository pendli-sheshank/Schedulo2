rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Chat images are scoped to a team. Only members of that team (proven by a
    // membership document in the named "schedulo2" Firestore database) may read,
    // upload, or delete them. Previously any authenticated user could read and
    // delete any team's images.
    match /chat_images/{teamId}/{imageId} {
      function isTeamMember() {
        return request.auth != null
          && firestore.exists(/databases/schedulo2/documents/team_members/$(teamId + '_' + request.auth.uid));
      }

      allow read: if isTeamMember();
      allow write: if isTeamMember()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isTeamMember();
    }

    // Screenshots attached to a feedback report, scoped to the reporter. The
    // path embeds the uid so ownership is decided by the path alone, without a
    // Firestore lookup — the feedback document doesn't exist yet at upload time.
    // Create only, deliberately: `write` would also grant update and delete, and
    // the feedback document referencing this image is immutable, so replacing or
    // removing the image would leave a report pointing at changed or dead content.
    match /feedback_screenshots/{userId}/{imageId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
